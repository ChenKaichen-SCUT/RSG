function {:existential true} b0(j : int, fac : int, t: int %FD%): bool;
function {:existential true} b1(j : int, fac : int, t: int): bool;

procedure main()
{
    var j : int;
    var t : int;
    var fac %VD%: int;
    havoc j;
    t := 1;
    fac := 1;

  %BE%

  assume (((fac <= 0) || (t <= 0) || (j > 0)) && ((j <= 3) || (t <= 0) || (fac - j < 1)) && ((j <= 7) || (t <= 0) || (j > 8) || (fac + t > 3)) && ((j <= 8) || (t <= 0) || (j > 9) || (fac + t > 3)) && ((j <= 9) || (t <= 0) || (j > 10) || (fac + t > 3)) && ((j <= 4) || (t <= -1) || (j > 5) || (fac - j < 19)) && ((j <= 6) || (t <= 0) || (j > 7) || (fac - j < 15)) && ((j <= 7) || (t <= 0) || (fac > 0) || (j > 8) || (fac + t <= 3)) && ((j <= 8) || (t <= 4) || (fac > 0) || (j > 9) || (fac + t <= 3)) && ((j <= 9) || (t <= 0) || (fac > 0) || (j > 10) || (fac + t <= 3)) && ((j <= 2) || (j > 3) || (j - t > 2) || (fac - j < 2)) && ((j <= 8) || (t <= 0) || (fac > 2) || (j > 9) || (t > 4) || (fac + t <= 3)) && ((j <= 4) || (t <= -1) || (j > 5) || (fac + t > 3) || (fac - j >= 19)) && ((fac <= 0) || (j <= 7) || (t <= 0) || (j > 8) || (fac + t <= 3) || (fac - j < 3)) && ((fac <= 0) || (j <= 8) || (t <= 4) || (j > 9) || (fac + t <= 3) || (fac - j < 2)) && ((fac <= 0) || (j <= 9) || (t <= 4) || (j > 10) || (fac + t <= 3) || (fac - j < 1)) && ((j <= 4) || (t <= -1) || (fac > 0) || (j > 5) || (fac + t <= 3) || (fac - j >= 19)) && ((fac >= j) || (fac <= 3) || (j <= 9) || (t <= 4) || (j > 10) || (fac + t <= 3) || (fac - j >= 1)) && ((fac >= j) || (fac <= t) || (j <= 6) || (t <= 0) || (j > 7) || (fac + t <= 9) || (fac - j >= 15)) && ((fac >= j) || (j <= 6) || (t <= 0) || (fac > t) || (j > 7) || (fac + t > 3) || (fac - j >= 15)) && ((fac <= 0) || (j <= 9) || (t <= 0) || (j > 10) || (t > 4) || (fac + t <= 3) || (fac - t > 2)) && ((fac <= 2) || (j <= 8) || (t <= 3) || (j > 9) || (t > 4) || (fac + t <= 3) || (fac - j >= -1)) && ((fac <= 2) || (j <= 8) || (t <= 3) || (j > 9) || (t > 4) || (fac + t <= 3) || (fac - j < 2)) && ((fac >= j) || (j <= 6) || (t <= 0) || (fac > 0) || (fac > t) || (j > 7) || (fac + t <= 3) || (fac - j >= 15)) && ((fac <= 2) || (fac <= t) || (j <= 8) || (t <= 0) || (j > 9) || (t > 3) || (fac + t <= 3) || (fac - t > 1)) && ((fac <= 0) || (j <= 7) || (t <= 0) || (j > 8) || (fac + t <= 3) || (fac - j >= -1) || (fac - j < -2)) && ((fac >= j) || (j <= 3) || (t <= 0) || (fac > 1) || (fac - j >= 1) || (fac - t <= -1) || (fac - j < -3)) && ((fac >= j) || (fac <= 1) || (j <= 4) || (t <= 0) || (j > 5) || (fac + t <= 5) || (fac - j >= 1) || (j - t <= -13)) && ((fac >= j) || (fac <= 2) || (j <= 8) || (t <= 4) || (j > 9) || (fac + t <= 3) || (fac - j >= 2) || (j - t <= 2)) && ((fac <= 0) || (j <= 9) || (t <= 2) || (j > 10) || (t > 4) || (fac + t <= 3) || (fac - t <= 2) || (fac - t > 5)) && ((fac <= 0) || (j <= 9) || (t <= 2) || (j > 10) || (t > 4) || (fac + t <= 3) || (fac - t <= 5) || (fac - j < 1)) && ((fac >= j) || (fac <= 0) || (j <= 2) || (fac > 1) || (j > 3) || (fac - j >= 2) || (fac - t <= -1) || (j - t > 2)) && ((fac <= 0) || (j <= 4) || (t <= 0) || (j > 5) || (fac + t <= 3) || (fac + t > 5) || (fac - j >= 19) || (j - t <= -13)) && ((fac >= j) || (j <= 3) || (t <= 0) || (fac - j >= 1) || (fac - t <= -2) || (fac - t > -1) || (fac - j < -3)) && ((fac <= 2) || (fac <= t) || (j <= 8) || (t <= 0) || (j > 9) || (t > 3) || (fac + t <= 3) || (fac - t <= 1) || (fac - t > 5)) && ((fac <= 2) || (fac <= t) || (j <= 8) || (t <= 0) || (j > 9) || (t > 3) || (fac + t <= 3) || (fac - t <= 5) || (fac - j < 1)) && ((fac <= 0) || (j <= 4) || (t <= 0) || (j > 5) || (fac + t <= 5) || (fac - j >= 19) || (j - t <= -13) || (fac - j < 1)) && ((fac >= j) || (fac <= 0) || (j <= 2) || (j > 3) || (fac - j >= 2) || (fac - t <= -2) || (fac - t > -1) || (j - t > 2)) && ((fac >= j) || (fac <= 1) || (j <= 6) || (t <= 2) || (fac > t) || (j > 7) || (t > 3) || (fac + t <= 3) || (fac - j >= 15) || (fac - t > -1)) && ((fac <= 0) || (j <= 7) || (t <= 0) || (fac > 2) || (j > 8) || (fac + t <= 3) || (fac - j >= -2) || (fac - t <= -2) || (j - t <= 1) || (fac - t > 1)) && ((fac <= 2) || (fac <= t) || (j <= 7) || (t <= 0) || (j > 8) || (fac + t <= 3) || (fac - j >= -2) || (fac - t <= -2) || (j - t <= 1) || (fac - t > 1))); // CondTerm
    while (j != fac) 
    invariant b0(j, fac, t %IC%);
    rec b1(j, fac, t)
    {
    %BT%
        fac := fac * t;
        t := t+1;

    %IT%
    }
	
    return ;
}
