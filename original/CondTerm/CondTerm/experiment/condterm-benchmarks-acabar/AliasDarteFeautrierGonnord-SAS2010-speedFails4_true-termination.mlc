!vars
x n b t

!pvars
x' n' b' t'

!path
b>=1
t=1
x<=n
b>=1
x'=x+t
n'=n
b'=b
t'=t

!path
b>=1
t=1
x<=n
b<=0
x'=x-t
n'=n
b'=b
t'=t

!path
b<=0
t=-1
x<=n
b>=1
x'=x+t
n'=n
b'=b
t'=t

!path
b<=0
t=-1
x<=n
b<=0
x'=x-t
n'=n
b'=b
t'=t

