!vars
x y

# these are the primed variables 
!pvars 
x' y'

# PATH 1
#
!path
x>=1
y'=y-1
x<=9
x'=x+1

# PATH 1-2
#
!path
x<=-1
y'=y-1
x'=x+1

# PATH 2
#
!path
x>=1
y'=y-1
x>=10
x'=y

